{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dropdown-12",
  "title": "Avatar menu",
  "description": "The avatar itself opens the account menu.",
  "dependencies": [],
  "registryDependencies": [
    "https://ui.ndekocode.dev/r/avatar.json",
    "https://ui.ndekocode.dev/r/button.json",
    "https://ui.ndekocode.dev/r/dropdown-menu.json",
    "https://ui.ndekocode.dev/r/icons.json",
    "https://ui.ndekocode.dev/r/theme.json"
  ],
  "files": [
    {
      "path": "registry/ndeko/components/dropdown/dropdown-12.tsx",
      "content": "import {\n  BoltIcon,\n  BookOpenIcon,\n  ChevronDownIcon,\n  Layers2Icon,\n  LogOutIcon,\n  PinIcon,\n  UserPenIcon,\n} from '@/registry/ndeko/lib/icons';\nimport { Avatar } from '@/registry/ndeko/ui/avatar';\nimport { Button } from '@/registry/ndeko/ui/button';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuGroup,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/registry/ndeko/ui/dropdown-menu';\n\nexport default function Dropdown12() {\n  return (\n    <DropdownMenu>\n      <DropdownMenuTrigger\n        render={\n          <Button\n            variant='ghost'\n            aria-label='Open account menu'\n            className='h-auto p-0 hover:bg-transparent data-popup-open:bg-transparent'\n          />\n        }\n      >\n        <Avatar seed='Keith Kennedy' />\n        <ChevronDownIcon className='opacity-60' />\n      </DropdownMenuTrigger>\n      <DropdownMenuContent className='max-w-64'>\n        <DropdownMenuLabel className='flex min-w-0 flex-col gap-0.5'>\n          <span className='text-foreground truncate text-[13px]'>\n            Keith Kennedy\n          </span>\n          <span className='truncate font-normal'>\n            keith.kennedy@example.com\n          </span>\n        </DropdownMenuLabel>\n        <DropdownMenuSeparator />\n        <DropdownMenuGroup>\n          <DropdownMenuItem>\n            <BoltIcon />\n            Preferences\n          </DropdownMenuItem>\n          <DropdownMenuItem>\n            <Layers2Icon />\n            Workspaces\n          </DropdownMenuItem>\n          <DropdownMenuItem>\n            <BookOpenIcon />\n            Documentation\n          </DropdownMenuItem>\n        </DropdownMenuGroup>\n        <DropdownMenuSeparator />\n        <DropdownMenuGroup>\n          <DropdownMenuItem>\n            <PinIcon />\n            Pinned items\n          </DropdownMenuItem>\n          <DropdownMenuItem>\n            <UserPenIcon />\n            Edit profile\n          </DropdownMenuItem>\n        </DropdownMenuGroup>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem>\n          <LogOutIcon />\n          Log out\n        </DropdownMenuItem>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  );\n}\n",
      "type": "registry:component"
    }
  ],
  "categories": [
    "components",
    "dropdown"
  ],
  "type": "registry:component"
}